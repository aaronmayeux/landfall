{"objectIdFieldName":"OBJECTID","uniqueIdField":{"name":"OBJECTID","isSystemMaintained":true},"globalIdFieldName":"","geometryType":"esriGeometryPolygon","spatialReference":{"wkid":102100,"latestWkid":3857},"fields":[{"name":"OBJECTID","type":"esriFieldTypeOID","alias":"OBJECTID","sqlType":"sqlTypeOther","domain":null,"defaultValue":null,"required":true},{"name":"event","type":"esriFieldTypeString","alias":"Event","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text denoting the type of the subject event of the alert message.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"headline","type":"esriFieldTypeString","alias":"Headline","sqlType":"sqlTypeOther","length":512,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text headline of the alert message. A brief human-readable headline. Note that some displays (for example, short messaging service devices) may only present this headline; it SHOULD be made as direct and actionable as possible while remaining short.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"severity","type":"esriFieldTypeString","alias":"Severity","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Severity","codedValues":[{"name":"Extraordinary threat to life or property.","code":"Extreme"},{"name":"Significant threat to life or property.","code":"Severe"},{"name":"Possible threat to life or property.","code":"Moderate"},{"name":"Minimal to no known threat to life or property.","code":"Minor"},{"name":"Severity unknown.","code":"Unknown"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the severity of the subject event of the alert message. Code Values: “Extreme” (extraordinary threat to life or property), “Severe” (significant threat to life or property), “Moderate” (possible threat to life or property), “Minor” (minimal to no known threat to life or property), “Unknown” (severity unknown)\",\"fieldValueType\":\"orderedOrRanked\"}"},{"name":"urgency","type":"esriFieldTypeString","alias":"Urgency","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Urgency","codedValues":[{"name":"Responsive action SHOULD be taken immediately.","code":"Immediate"},{"name":"Responsive action SHOULD be taken soon, within next hour.","code":"Expected"},{"name":"Responsive action SHOULD be taken in the near future.","code":"Future"},{"name":"Responsive action is no longer required.","code":"Past"},{"name":"Urgency not known.","code":"Unknown"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the urgency of the subject event of the alert message. Code Values: “Immediate” (responsive action SHOULD be taken immediately), “Expected” (responsive action SHOULD be taken soon, within next hour), “Future” (responsive action SHOULD be taken in the near future), “Past” (responsive action is no longer required), “Unknown” (urgency not known)\",\"fieldValueType\":\"orderedOrRanked\"}"},{"name":"certainty","type":"esriFieldTypeString","alias":"Certainty","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Certainty","codedValues":[{"name":"Determined to have occurred or to be ongoing.","code":"Observed"},{"name":"Likely (p \u003e ~50%)","code":"Likely"},{"name":"Possible but not likely (p \u003c= ~50%)","code":"Possible"},{"name":"Not expected to occur (p ~ 0)","code":"Unlikely"},{"name":"Certainty unknown","code":"Unknown"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the certainty of the subject event of the alert message. Code Values: “Observed” (determined to have occurred or to be ongoing), “Likely” (likely, p \u003e ~50%), “Possible” (possible but not likely, p \u003c= ~50%), “Unlikely” (not expected to occur, p ~ 0), “Unknown” (certainty unknown)\",\"fieldValueType\":\"orderedOrRanked\"}"},{"name":"senderName","type":"esriFieldTypeString","alias":"Sender Name","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text naming the originator of the alert message. The human-readable name of the agency or authority issuing this alert.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"countryCode","type":"esriFieldTypeString","alias":"Country Code","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"An identifier assigned by the republisher of the CAP alert source, denoting the ISO 3166 2-character alpha code for the country of the CAP alert publisher. or 'int' if international.\",\"fieldValueType\":\"locationOrPlaceName\"}"},{"name":"areaDesc","type":"esriFieldTypeString","alias":"Area Description","sqlType":"sqlTypeOther","length":2147483647,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text describing the affected area of the alert message. A text description of the affected area.\",\"fieldValueType\":\"description\"}"},{"name":"effective","type":"esriFieldTypeDate","alias":"Effective","sqlType":"sqlTypeOther","length":8,"domain":null,"defaultValue":null,"description":"{\"value\":\"The effective time of the information of the alert message. If this item is not included, the effective time SHALL be assumed to be the same as in 'sent' field.\",\"fieldValueType\":\"dateAndTime\"}"},{"name":"expires","type":"esriFieldTypeDate","alias":"Expires","sqlType":"sqlTypeOther","length":8,"domain":null,"defaultValue":null,"description":"{\"value\":\"The expiry time of the information of the alert message. If this item is not provided, each recipient is free to set its own policy as to when the message is no longer in effect.\",\"fieldValueType\":\"dateAndTime\"}"},{"name":"sent","type":"esriFieldTypeDate","alias":"Sent","sqlType":"sqlTypeOther","length":8,"domain":null,"defaultValue":null,"description":"{\"value\":\"The time and date of the origination of the alert message.\",\"fieldValueType\":\"dateAndTime\"}"},{"name":"language","type":"esriFieldTypeString","alias":"Language","sqlType":"sqlTypeOther","length":50,"domain":null,"defaultValue":null,"description":"{\"value\":\"The code denoting the language of the 'info' sub-element of the alert message. Code Values: Natural language identifier per [RFC 3066]. If not present, an implicit default value of “en-US” SHALL be assumed. A null value in this element SHALL be considered equivalent to “en-US”.\",\"fieldValueType\":\"typeOrCategory\"}"},{"name":"status","type":"esriFieldTypeString","alias":"Status","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Status","codedValues":[{"name":"Actionable by all targeted recipients.","code":"Actual"},{"name":"Actionable only by designated exercise participants; exercise identifier SHOULD appear in 'note' field.","code":"Exercise"},{"name":"For messages that support alert network internal functions.","code":"System"},{"name":"Technical testing only, all recipients disregard.","code":"Test"},{"name":"A preliminary template or draft, not actionable in its current form.","code":"Draft"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the appropriate handling of the alert message. Code Values: “Actual” (actionable by all targeted recipients), “Exercise” (actionable only by designated exercise participants; exercise identifier SHOULD appear in 'note' field), “System” (for messages that support alert network internal functions), “Test” (technical testing only, all recipients disregard), “Draft” (a preliminary template or draft, not actionable in its current form)\",\"fieldValueType\":\"typeOrCategory\"}"},{"name":"msgType","type":"esriFieldTypeString","alias":"Message Type","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"MessageType","codedValues":[{"name":"Initial information requiring attention by targeted recipients.","code":"Alert"},{"name":"Updates and supercedes the earlier message(s) identified in 'references' field.","code":"Update"},{"name":"Cancels the earlier message(s) identified in 'references' field.","code":"Cancel"},{"name":"Acknowledges receipt and acceptance of the message(s) identified in 'references' field.","code":"Ack"},{"name":"Indicates rejection of the message(s) identified in 'references' field; explanation SHOULD appear in 'note' field.","code":"Error"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the nature of the alert message. Code Values: “Alert” (initial information requiring attention by targeted recipients), “Update” (updates and supercedes the earlier messages identified in 'references'), “Cancel” (cancels the earlier messages identified in 'references'), “Ack” (acknowledges receipt and acceptance of the messages identified in 'references'), “Error” (indicates rejection of the messages identified in 'references'; explanation SHOULD appear in 'note')\",\"fieldValueType\":\"typeOrCategory\"}"},{"name":"responseType","type":"esriFieldTypeString","alias":"Response Type","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"The code(s) denoting the type of action recommended for the target audience as per 'instruction' field! Multi-Code List: “Shelter” (take shelter), “Evacuate” (relocate), “Prepare” (make preparations), “Execute” (execute a pre-planned activity), “Avoid” (avoid the subject event), “Monitor” (attend to information sources), “Assess” (evaluate the information in this message), “AllClear” (the subject event no longer poses a threat or concern and see follow on action), “None” (no action recommended)\",\"fieldValueType\":\"typeOrCategory\"}"}],"features":[{"attributes":{"OBJECTID":10164527,"event":"storm surge","headline":"yellow warning - storm surge - in effect","severity":"Moderate","urgency":"Immediate","certainty":"Likely","senderName":"Environment Canada","countryCode":"ca","areaDesc":"Coastline of Yukon incl. Herschel Island","effective":1791627667000,"expires":1791685267000,"sent":1791627667000,"language":"en-CA","status":"Actual","msgType":"Upd