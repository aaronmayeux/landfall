{"objectIdFieldName":"OBJECTID","uniqueIdField":{"name":"OBJECTID","isSystemMaintained":true},"globalIdFieldName":"","geometryType":"esriGeometryPolygon","spatialReference":{"wkid":102100,"latestWkid":3857},"fields":[{"name":"OBJECTID","type":"esriFieldTypeOID","alias":"OBJECTID","sqlType":"sqlTypeOther","domain":null,"defaultValue":null,"required":true},{"name":"event","type":"esriFieldTypeString","alias":"Event","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text denoting the type of the subject event of the alert message.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"headline","type":"esriFieldTypeString","alias":"Headline","sqlType":"sqlTypeOther","length":512,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text headline of the alert message. A brief human-readable headline. Note that some displays (for example, short messaging service devices) may only present this headline; it SHOULD be made as direct and actionable as possible while remaining short.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"severity","type":"esriFieldTypeString","alias":"Severity","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Severity","codedValues":[{"name":"Extraordinary threat to life or property.","code":"Extreme"},{"name":"Significant threat to life or property.","code":"Severe"},{"name":"Possible threat to life or property.","code":"Moderate"},{"name":"Minimal to no known threat to life or property.","code":"Minor"},{"name":"Severity unknown.","code":"Unknown"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the severity of the subject event of the alert message. Code Values: “Extreme” (extraordinary threat to life or property), “Severe” (significant threat to life or property), “Moderate” (possible threat to life or property), “Minor” (minimal to no known threat to life or property), “Unknown” (severity unknown)\",\"fieldValueType\":\"orderedOrRanked\"}"},{"name":"urgency","type":"esriFieldTypeString","alias":"Urgency","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Urgency","codedValues":[{"name":"Responsive action SHOULD be taken immediately.","code":"Immediate"},{"name":"Responsive action SHOULD be taken soon, within next hour.","code":"Expected"},{"name":"Responsive action SHOULD be taken in the near future.","code":"Future"},{"name":"Responsive action is no longer required.","code":"Past"},{"name":"Urgency not known.","code":"Unknown"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the urgency of the subject event of the alert message. Code Values: “Immediate” (responsive action SHOULD be taken immediately), “Expected” (responsive action SHOULD be taken soon, within next hour), “Future” (responsive action SHOULD be taken in the near future), “Past” (responsive action is no longer required), “Unknown” (urgency not known)\",\"fieldValueType\":\"orderedOrRanked\"}"},{"name":"certainty","type":"esriFieldTypeString","alias":"Certainty","sqlType":"sqlTypeOther","length":25,"domain":{"type":"codedValue","name":"Certainty","codedValues":[{"name":"Determined to have occurred or to be ongoing.","code":"Observed"},{"name":"Likely (p \u003e ~50%)","code":"Likely"},{"name":"Possible but not likely (p \u003c= ~50%)","code":"Possible"},{"name":"Not expected to occur (p ~ 0)","code":"Unlikely"},{"name":"Certainty unknown","code":"Unknown"}]},"defaultValue":null,"description":"{\"value\":\"The code denoting the certainty of the subject event of the alert message. Code Values: “Observed” (determined to have occurred or to be ongoing), “Likely” (likely, p \u003e ~50%), “Possible” (possible but not likely, p \u003c= ~50%), “Unlikely” (not expected to occur, p ~ 0), “Unknown” (certainty unknown)\",\"fieldValueType\":\"orderedOrRanked\"}"},{"name":"senderName","type":"esriFieldTypeString","alias":"Sender Name","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text naming the originator of the alert message. The human-readable name of the agency or authority issuing this alert.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"countryCode","type":"esriFieldTypeString","alias":"Country Code","sqlType":"sqlTypeOther","length":255,"domain":null,"defaultValue":null,"description":"{\"value\":\"An identifier assigned by the republisher of the CAP alert source, denoting the ISO 3166 2-character alpha code for the country of the CAP alert publisher. or 'int' if international.\",\"fieldValueType\":\"locationOrPlaceName\"}"},{"name":"areaDesc","type":"esriFieldTypeString","alias":"Area Description","sqlType":"sqlTypeOther","length":2147483647,"domain":null,"defaultValue":null,"description":"{\"value\":\"The text describing the affected area of the alert message. A text description of the affected area.\",\"fieldValueType\":\"description\"}"},{"name":"effective","type":"esriFieldTypeDate","alias":"Effective","sqlType":"sqlTypeOther","length":8,"domain":null,"defaultValue":null,"description":"{\"value\":\"The effective time of the information of the alert message. If this item is not included, the effective time SHALL be assumed to be the same as in 'sent' field.\",\"fieldValueType\":\"dateAndTime\"}"},{"name":"expires","type":"esriFieldTypeDate","alias":"Expires","sqlType":"sqlTypeOther","length":8,"domain":null,"defaultValue":null,"description":"{\"value\":\"The expiry time of the information of the alert message. If this item is not provided, each recipient is free to set its own policy as to when the message is no longer in effect.\",\"fieldValueType\":\"dateAndTime\"}"},{"name":"sent","type":"esriFieldTypeDate","alias":"Sent","sqlType":"sqlTypeOther","length":8,"domain":null,"defaultValue":null,"description":"{\"value\":\"The time and date of the origination of the alert message.\",\"fieldValueType\":\"dateAndTime\"}"},{"name":"language","type":"esriFieldTypeString","alias":"Language","sqlType":"sqlTy