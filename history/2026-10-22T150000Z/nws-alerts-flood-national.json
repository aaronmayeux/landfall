                    ],
                    "WEAHandling": [
                        "Imminent Threat"
                    ],
                    "CMAMtext": [
                        "NWS: FLASH FLOOD WARNING this area til 10:15 AM MDT. Avoid flooded areas."
                    ],
                    "CMAMlongtext": [
                        "National Weather Service: A FLASH FLOOD WARNING is in effect for this area until 10:15 AM MDT. This is a dangerous and life-threatening situation. Do not attempt to travel unless you are fleeing an area subject to flooding or under an evacuation order."
                    ]
